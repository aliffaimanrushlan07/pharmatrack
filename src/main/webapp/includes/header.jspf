<%--
    Shared page header + navigation bar.
    OWNER: AMIR (Interface Design)

    Included at the top of every logged-in page with:
        <%@ include file="/includes/header.jspf" %>

    A .jspf ("JSP fragment") is not a complete page - it has no <html> tag of
    its own and cannot be requested directly in a browser. Using one include
    for the navigation means adding a menu item happens once, not on eight
    separate pages. The examiner notices inconsistent navigation.

    Set ${pageTitle} and ${activeNav} before including it.
--%>
<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="fn"  uri="http://java.sun.com/jsp/jstl/functions" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty pageTitle ? 'PharmaTrack' : pageTitle}"/> | PharmaTrack</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
</head>
<body>

<nav class="navbar">
    <div class="navbar-inner">
        <a href="${pageContext.request.contextPath}/dashboard.jsp" class="brand">PharmaTrack</a>

        <a href="${pageContext.request.contextPath}/dashboard.jsp"
           class="${activeNav eq 'dashboard' ? 'active' : ''}">Dashboard</a>
        <a href="${pageContext.request.contextPath}/medicine"
           class="${activeNav eq 'medicine' ? 'active' : ''}">Medicines</a>
        <a href="${pageContext.request.contextPath}/supplier"
           class="${activeNav eq 'supplier' ? 'active' : ''}">Suppliers</a>
        <a href="${pageContext.request.contextPath}/sale"
           class="${activeNav eq 'sale' ? 'active' : ''}">New Sale</a>
        <a href="${pageContext.request.contextPath}/search"
           class="${activeNav eq 'search' ? 'active' : ''}">Search</a>
        <a href="${pageContext.request.contextPath}/report?type=lowstock"
           class="${activeNav eq 'report' ? 'active' : ''}">Reports</a>

        <span class="spacer"></span>
        <span class="user-chip">
            <strong><c:out value="${loggedInUser.fullName}"/></strong>
            <span class="badge badge-role"><c:out value="${loggedInUser.role}"/></span>
        </span>
        <a href="${pageContext.request.contextPath}/logout">Log out</a>
    </div>
</nav>

<div class="container">

    <%-- Flash messages. MedicineServlet passes these through the query string
         after a redirect (POST-redirect-GET); other pages set them as request
         attributes. Both are handled here so no page has to repeat it.
         <c:out> escapes the value, which is what stops a medicine named
         <script>...</script> from executing. --%>
    <c:if test="${not empty param.success}">
        <div class="alert alert-success"><c:out value="${param.success}"/></div>
    </c:if>
    <c:if test="${not empty param.error}">
        <div class="alert alert-error"><c:out value="${param.error}"/></div>
    </c:if>
    <c:if test="${not empty errorMessage}">
        <div class="alert alert-error"><c:out value="${errorMessage}"/></div>
    </c:if>
    <c:if test="${not empty successMessage}">
        <div class="alert alert-success"><c:out value="${successMessage}"/></div>
    </c:if>
    <c:if test="${not empty infoMessage}">
        <div class="alert alert-info"><c:out value="${infoMessage}"/></div>
    </c:if>
