<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   PharmaTrack - Deployment descriptor
   OWNER: Aliff (Architecture)
  ============================================================================
   Note how little is in here. Servlets and filters are declared with
   @WebServlet and @WebFilter annotations in the Java files themselves, which
   is the Java EE 6+ way and keeps each component's configuration next to its
   code. This file is only for settings that are application-wide and have no
   annotation equivalent: welcome page, session timeout, error pages.

   Do NOT also declare the servlets here. Declaring a servlet in both the
   annotation and web.xml is a common cause of "servlet already mapped" errors
   on deployment.
  ============================================================================
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>PharmaTrack - Pharmacy Inventory and Sales Management System</display-name>

    <!-- First page a visitor sees. index.jsp decides where to send them. -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- 30 minutes of inactivity ends the session.
         AuthFilter then redirects to the login page with ?timeout=1 -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <!-- HttpOnly stops JavaScript reading the session cookie,
                 which blunts session hijacking via XSS. -->
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Friendly error pages instead of a Tomcat stack trace.
         Showing a stack trace to a user leaks class names, file paths and
         library versions - a real finding in a security review, and an easy
         mark to lose in the Security band. -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/error/500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/error/500.jsp</location>
    </error-page>

</web-app>
